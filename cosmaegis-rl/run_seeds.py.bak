import os
import sys
import time
import subprocess
from concurrent.futures import ThreadPoolExecutor, as_completed

HERE = os.path.dirname(os.path.abspath(__file__))
RESULTS = os.path.join(HERE, "results")
LOGS = os.path.join(RESULTS, "logs")

VARIANTS = ["baseline", "risk_only", "uncertainty_only", "full"]
SEEDS = [1, 2, 3, 4]
STEPS = 300000


def run_job(job):
    variant, seed = job
    model = os.path.join(RESULTS, f"ppo_{variant}_s{seed}.pt")
    if os.path.exists(model):
        return f"skip   {variant} s{seed} (model already exists)"

    env = dict(os.environ)
    env["OMP_NUM_THREADS"] = "1"
    log = os.path.join(LOGS, f"{variant}_s{seed}.txt")
    t0 = time.time()
    with open(log, "w") as f:
        rc = subprocess.run(
            [sys.executable, os.path.join(HERE, "ppo_train.py"),
             "--variant", variant, "--seed", str(seed),
             "--steps", str(STEPS), "--no-refs"],
            stdout=f, stderr=subprocess.STDOUT, env=env, cwd=HERE,
        ).returncode
    mins = (time.time() - t0) / 60.0
    if rc == 0:
        return f"done   {variant} s{seed} in {mins:.1f} min"
    return f"FAILED {variant} s{seed} (exit code {rc}) - see {log}"


def main():
    workers = int(sys.argv[1]) if len(sys.argv) > 1 else 3
    os.makedirs(LOGS, exist_ok=True)
    jobs = [(v, s) for s in SEEDS for v in VARIANTS]
    print(f"{len(jobs)} jobs, {workers} at a time. Logs in {LOGS}", flush=True)
    with ThreadPoolExecutor(max_workers=workers) as ex:
        futures = [ex.submit(run_job, j) for j in jobs]
        for fut in as_completed(futures):
            print(fut.result(), flush=True)
    print("All jobs finished.")


if __name__ == "__main__":
    main()